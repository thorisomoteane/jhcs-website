# Copy this file to .env.local and fill in real values.
# Every key here is NEXT_PUBLIC_*, meaning it is inlined into the browser
# bundle at build time. That is expected for Firebase web config — access is
# controlled by Firestore Security Rules (see firestore.rules), not by keeping
# these values secret. Do NOT add server-only secrets with a NEXT_PUBLIC_ prefix.

# --- Firebase -------------------------------------------------------------
# Firebase console -> Project settings -> Your apps -> SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed if/when Firebase Analytics is wired up (not currently used in code)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Site contact details -------------------------------------------------
# Rendered on /contact and in the footer. Defaults in src/lib/constants/site.ts
# are placeholders.
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_SITE_PHONE=
NEXT_PUBLIC_SITE_ADDRESS=
NEXT_PUBLIC_SITE_URL=https://jhcs.org.za

# --- Banking details ------------------------------------------------------
# WARNING: rendered publicly on /donate. Until these are set, the page shows
# placeholder values ("Example Bank", account 0000000000).
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BRANCH_CODE=
NEXT_PUBLIC_BANK_REFERENCE=

# --- Social links ---------------------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
